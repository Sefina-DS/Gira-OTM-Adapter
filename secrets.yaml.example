# Kopiere diese Datei nach secrets.yaml und trage die echten Werte ein.
# secrets.yaml wird per .gitignore vom Repo ausgeschlossen und darf
# NIEMALS committed werden.

wifi_ssid: "DEIN_WLAN"
wifi_password: "DEIN_WLAN_PASSWORT"

api_key: "BASE64_KEY_HIER_EINTRAGEN"       # 32-byte base64
ota_password: "DEIN_OTA_PASSWORT"

# Optional (kommt spaeter, wenn MQTT-Anbindung dran ist):
# mqtt_broker: "192.168.7.X"
# mqtt_username: "gira"
# mqtt_password: "..."
